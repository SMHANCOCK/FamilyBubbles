<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.MainActivity">

    <!-- Soft decorative FamilyBubbles shapes. These never intercept taps. -->
    <View
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-76dp"
        android:layout_marginTop="194dp"
        android:alpha="0.72"
        android:background="@drawable/decor_bubble_pink"
        android:clickable="false" />

    <View
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="54dp"
        android:layout_marginTop="116dp"
        android:alpha="0.9"
        android:background="@drawable/decor_bubble_blue"
        android:clickable="false" />

    <View
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="116dp"
        android:layout_marginTop="166dp"
        android:alpha="0.92"
        android:background="@drawable/decor_bubble_green"
        android:clickable="false" />

    <View
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="136dp"
        android:layout_marginEnd="42dp"
        android:alpha="0.86"
        android:background="@drawable/decor_bubble_green"
        android:clickable="false" />

    <View
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="188dp"
        android:layout_marginEnd="9dp"
        android:alpha="0.92"
        android:background="@drawable/decor_bubble_pink"
        android:clickable="false" />

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="74dp"
        android:layout_marginTop="68dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_heart_pink" />

    <View
        android:layout_width="164dp"
        android:layout_height="164dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-92dp"
        android:layout_marginBottom="-70dp"
        android:alpha="0.74"
        android:background="@drawable/decor_bubble_green"
        android:clickable="false" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-94dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.74"
        android:background="@drawable/decor_bubble_pink"
        android:clickable="false" />

    <ImageView
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="46dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_heart_pink" />

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="54dp"
        android:layout_marginBottom="70dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_heart_pink"
        app:tint="@color/family_green" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/content_top_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/content_bottom_padding">

            <ImageView
                android:id="@+id/logoView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/familybubbles_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:text="@string/intro_heading"
                android:textColor="@color/family_navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/intro_supporting"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/permissionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_calling_card"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp">

                    <View
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="bottom|start"
                        android:background="@drawable/bg_mint_circle" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/one_tap_calling"
                        android:src="@drawable/ic_phone_green" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="top|end"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_header_rays" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/one_tap_calling"
                        android:textColor="@color/family_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/permissionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-rounded"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permissionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-rounded"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/allow_calls"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_blue"
                        app:cornerRadius="22dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:rotation="12"
                    android:src="@drawable/ic_header_rays"
                    app:tint="@color/family_blue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-rounded"
                    android:text="@string/family_members"
                    android:textColor="@color/family_navy"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/addButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_add_person_button"
                    android:clickable="true"
                    android:contentDescription="@string/add_person"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minWidth="148dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="18dp">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_add_person_icon_circle">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="sans-serif-rounded"
                        android:text="@string/add_person"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_empty_card"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="24dp"
                android:text="@string/empty_people"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="4dp"
                tools:listitem="@layout/item_person" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/footer_top_spacing"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/setup_help"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
